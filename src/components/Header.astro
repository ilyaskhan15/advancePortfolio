---
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-deep/90 backdrop-blur">
  <div class="section-shell flex min-h-18 items-center justify-between gap-4">
    <a class="display text-xl font-bold" href={withBase('')} aria-label={`${site.name} home`}><span class="text-accent">{site.initials}</span><span class="hidden sm:inline"> / portfolio</span></a>
    <nav class="hidden items-center gap-6 text-sm lg:flex" aria-label="Primary navigation">
      {['about', 'skills', 'projects', 'experience', 'contact'].map((item) => <a class="transition-colors hover:text-accent" href={withBase(`#${item}`)}>{item}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a class="hidden border border-line px-3 py-2 text-sm font-bold transition-colors hover:border-accent hover:text-accent sm:inline-flex" href={withBase(site.resume)} download>Resume</a>
      <button class="grid size-10 place-items-center border border-line text-lg transition-colors hover:border-accent" type="button" data-theme-toggle aria-label="Switch to light theme">◐</button>
      <button class="grid size-10 place-items-center border border-line text-lg lg:hidden" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation">☰</button>
    </div>
  </div>
  <nav id="mobile-menu" class="section-shell hidden border-t border-line/70 py-4 lg:hidden [&[data-open]]:grid" data-mobile-menu aria-label="Mobile navigation">
    {['about', 'skills', 'projects', 'experience', 'contact'].map((item) => <a class="py-2 text-sm uppercase tracking-wider hover:text-accent" href={withBase(`#${item}`)}>{item}</a>)}
    <a class="border border-line px-3 py-2 text-center text-sm font-bold sm:hidden" href={withBase(site.resume)} download>Download resume</a>
  </nav>
</header>
