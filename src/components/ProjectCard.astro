---
import { withBase } from '../utils/paths';
interface Props { slug: string; title: string; stack: string[]; description: string; repo: string; }
const { slug, title, stack, description, repo } = Astro.props;
const hasRepo = repo !== 'PLACEHOLDER' && repo.startsWith('http');
---
<article class="panel group flex h-full flex-col justify-between p-6 transition-transform duration-300 hover:-translate-y-1 hover:border-accent">
  <div>
    <div class="mb-8 flex items-start justify-between gap-4"><span class="eyebrow">Project / {slug}</span><span class="text-2xl text-accent transition-transform group-hover:translate-x-1">↗</span></div>
    <h3 class="display text-2xl font-bold">{title}</h3>
    <p class="mt-3 muted">{description}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${title} technology stack`}>
      {stack.map((item) => <li class="border border-line px-2 py-1 text-xs text-mute">{item}</li>)}
    </ul>
  </div>
  <div class="mt-8 flex gap-3">
    <a class="inline-flex items-center gap-2 text-sm font-bold text-accent hover:underline" href={withBase(`projects/${slug}`)}>View details <span aria-hidden="true">→</span></a>
    {hasRepo && <a class="inline-flex items-center gap-2 text-sm font-bold hover:text-accent" href={repo} target="_blank" rel="noreferrer">Code <span aria-hidden="true">↗</span></a>}
  </div>
</article>
