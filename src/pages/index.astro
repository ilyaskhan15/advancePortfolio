---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  about,
  education,
  experience,
  interests,
  languages,
  site,
  skillGroups,
} from '../data/site';
import { withBase } from '../utils/paths';
import profileImage from '../assets/profile.jpg';

const projects = await getCollection('projects');
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        jobTitle: site.title,
        url: new URL(withBase(''), Astro.site),
        email: site.email,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Mingora',
          addressRegion: 'Swat',
          addressCountry: 'Pakistan',
        },
        sameAs: [site.github, site.linkedin],
      })}
    />
  </Fragment>
  <Header />
  <main id="main">
    <section
      class="section-shell grid min-h-[calc(100svh-4.5rem)] items-center gap-12 py-16 lg:grid-cols-[1.15fr_.85fr] lg:gap-20 lg:py-24"
      aria-labelledby="hero-title"
    >
      <div class="reveal">
        <p class="eyebrow mb-6">Available for the next chapter</p>
        <h1
          id="hero-title"
          class="display max-w-4xl text-5xl font-bold leading-[.95] sm:text-7xl lg:text-[6.5rem]"
        >
          Muhammad <span class="text-accent">Ilyas</span>
        </h1>
        <p class="mt-7 max-w-xl text-xl font-medium sm:text-2xl">
          Software Engineer <span class="text-accent">|</span> Full-Stack Development
        </p>
        <p class="mt-5 max-w-lg text-lg muted">
          Building practical, thoughtful products with strong full-stack fundamentals.
        </p>
        <div
          class="mt-7 inline-flex items-center gap-2 border border-accent/60 px-3 py-2 text-sm font-bold text-accent"
        >
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span> Seeking a full-stack
          development role
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            class="bg-accent px-5 py-3 font-bold text-deep transition-transform hover:-translate-y-1"
            href={withBase('#projects')}>View projects <span aria-hidden="true">↘</span></a
          >
          <a
            class="border border-line px-5 py-3 font-bold transition-colors hover:border-accent hover:text-accent"
            href={withBase('#contact')}>Contact me</a
          >
          <a
            class="border border-line px-5 py-3 font-bold transition-colors hover:border-accent hover:text-accent"
            href={withBase(site.resume)}
            download>Download resume</a
          >
        </div>
        <div class="mt-10 flex gap-5 text-sm font-bold">
          <a
            class="hover:text-accent"
            href={site.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub profile">GitHub ↗</a
          >
          <a
            class="hover:text-accent"
            href={site.linkedin}
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn profile">LinkedIn ↗</a
          >
          <a
            class="hover:text-accent"
            href={`mailto:${site.email}`}
            aria-label="Email Muhammad Ilyas">Email ↗</a
          >
        </div>
      </div>
      <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -right-3 -top-3 h-full w-full border border-accent/60"></div>
        <div class="relative overflow-hidden bg-panel p-3">
          <Image
            src={profileImage}
            alt="Neutral profile placeholder for Muhammad Ilyas"
            width={640}
            height={640}
            fetchpriority="high"
          />
        </div>
        <p class="mt-4 flex justify-between text-xs uppercase tracking-[.18em] text-mute">
          <span>Mingora / Pakistan</span><span>01 — 01</span>
        </p>
      </div>
    </section>

    <section id="about" class="section border-t border-line/70" aria-labelledby="about-title">
      <div class="section-shell grid gap-10 lg:grid-cols-[.65fr_1.35fr] lg:gap-24">
        <div class="reveal">
          <p class="eyebrow">01 / About</p><h2
            id="about-title"
            class="display section-heading mt-4"
          >
            Grounded in the fundamentals.
          </h2>
        </div><div class="reveal">
          <p class="max-w-3xl text-2xl leading-relaxed">{about}</p><dl
            class="mt-12 grid gap-6 border-t border-line pt-7 sm:grid-cols-3"
          >
            <div><dt class="eyebrow">Location</dt><dd class="mt-2">{site.location}</dd></div><div>
              <dt class="eyebrow">Degree</dt><dd class="mt-2">Software Engineering</dd>
            </div><div>
              <dt class="eyebrow">Languages</dt><dd class="mt-2">Pashto, Urdu, English</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="skills" class="section border-t border-line/70" aria-labelledby="skills-title">
      <div class="section-shell">
        <div class="reveal">
          <p class="eyebrow">02 / Toolkit</p><h2
            id="skills-title"
            class="display section-heading mt-4"
          >
            Tools for useful work.
          </h2>
        </div><div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            skillGroups.map((group, index) => (
              <article class:list={['panel', 'reveal', 'p-5', index === 0 && 'lg:col-span-2']}>
                <>
                  <p class="font-bold text-accent">{group.label}</p>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <li class="border border-line px-2 py-1 text-sm muted">{item}</li>
                    ))}
                  </ul>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="projects" class="section border-t border-line/70" aria-labelledby="projects-title">
      <div class="section-shell">
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div class="reveal">
            <p class="eyebrow">03 / Selected work</p><h2
              id="projects-title"
              class="display section-heading mt-4"
            >
              Made to be used.
            </h2>
          </div><p class="max-w-xs muted">
            A small set of full-stack projects built while developing practical engineering range.
          </p>
        </div><div class="mt-12 grid gap-4 lg:grid-cols-3">
          {projects.map((project) => <ProjectCard slug={project.slug} {...project.data} />)}
        </div>
      </div>
    </section>

    <section
      id="experience"
      class="section border-t border-line/70"
      aria-labelledby="experience-title"
    >
      <div class="section-shell grid gap-16 lg:grid-cols-2">
        <div>
          <div class="reveal">
            <p class="eyebrow">04 / Experience</p><h2
              id="experience-title"
              class="display section-heading mt-4"
            >
              Learning by shipping.
            </h2>
          </div><article class="reveal mt-12 border-l border-accent pl-6">
            <p class="eyebrow">{experience.dates}</p><h3 class="display mt-3 text-2xl font-bold">
              {experience.role}
            </h3><p class="mt-1 text-lg">{experience.company}</p><p class="mt-1 muted">
              {experience.location}
            </p><ul class="mt-7 space-y-4 muted">
              {
                experience.bullets.map((bullet) => (
                  <li class="flex gap-3">
                    <>
                      <span class="text-accent" aria-hidden="true">
                        +
                      </span>
                      <span>{bullet}</span>
                    </>
                  </li>
                ))
              }
            </ul>
          </article>
        </div><div>
          <div class="reveal">
            <p class="eyebrow">Education</p><h2 class="display mt-4 text-4xl font-bold">
              A steady foundation.
            </h2>
          </div><div class="mt-12 space-y-0">
            {
              education.map((item) => (
                <article class="reveal border-t border-line py-6">
                  <>
                    <div class="flex flex-wrap justify-between gap-3">
                      <>
                        <p class="eyebrow">{item.dates}</p>
                        <p class="text-sm text-accent">{item.result}</p>
                      </>
                    </div>
                    <h3 class="display mt-3 text-xl font-bold">{item.degree}</h3>
                    <p class="mt-1 muted">{item.school}</p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section border-t border-line/70" aria-labelledby="languages-title">
      <div class="section-shell grid gap-16 lg:grid-cols-[.7fr_1.3fr]">
        <div class="reveal">
          <p class="eyebrow">05 / Beyond code</p><h2
            id="languages-title"
            class="display section-heading mt-4"
          >
            Curious by default.
          </h2>
        </div><div class="grid gap-12 sm:grid-cols-2">
          <div class="reveal">
            <h3 class="display text-2xl font-bold">Languages</h3><div class="mt-5 space-y-5">
              {
                languages.map((language) => (
                  <div class="border-t border-line pt-3">
                    <div class="flex justify-between gap-4">
                      <>
                        <span class="font-bold">{language.name}</span>
                        <span class="text-accent">{language.level}</span>
                      </>
                    </div>
                    {language.details && <p class="mt-1 text-sm muted">{language.details}</p>}
                  </div>
                ))
              }
            </div>
          </div><div class="reveal">
            <h3 class="display text-2xl font-bold">Interests</h3><ul class="mt-5 space-y-3 muted">
              {interests.map((interest) => <li class="border-t border-line pt-3">{interest}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section border-y border-line/70" aria-labelledby="contact-title">
      <div class="section-shell grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="reveal">
          <p class="eyebrow">06 / Contact</p><h2
            id="contact-title"
            class="display mt-4 max-w-3xl text-5xl font-bold leading-none sm:text-7xl"
          >
            Let’s build something <span class="text-accent">useful.</span>
          </h2><p class="mt-6 max-w-xl text-lg muted">
            I’m looking for a professional full-stack development role where I can contribute,
            learn, and keep growing.
          </p>
        </div><div class="reveal flex flex-col items-start gap-4 lg:items-end">
          <a class="text-xl font-bold text-accent hover:underline" href={`mailto:${site.email}`}
            >{site.email}</a
          ><div class="flex gap-5 text-sm font-bold">
            <a href={site.github} target="_blank" rel="noreferrer" class="hover:text-accent"
              >GitHub ↗</a
            ><a href={site.linkedin} target="_blank" rel="noreferrer" class="hover:text-accent"
              >LinkedIn ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer class="section-shell flex flex-col justify-between gap-3 py-8 text-sm muted sm:flex-row">
    <p>© {new Date().getFullYear()} {site.name}</p><p>
      Built with Astro · <a
        class="hover:text-accent"
        href={site.github}
        target="_blank"
        rel="noreferrer">GitHub ↗</a>
    </p>
  </footer>
</Layout>
